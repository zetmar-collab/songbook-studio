{
  "name": "songbook-studio",
  "version": "1.0.0",
  "description": "Desktopowa aplikacja do organizowania tekstów piosenek, akordów i pomysłów na utwory. Działa offline, z generowaniem akordów przez AI.",
  "main": "./out/main/index.js",
  "author": "Marek",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:portable": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "docx": "^9.1.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "i18next": "^24.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
